{
  "name": "fathi",
  "productName": "Fathi",
  "version": "1.0.2",
  "description": "Private browser with a unique identity in every tab",
  "author": {
    "name": "iMumd",
    "email": "hi@mumd.dev",
    "url": "https://github.com/iMumd"
  },
  "homepage": "https://github.com/iMumd/fathi-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iMumd/fathi-browser.git"
  },
  "bugs": {
    "url": "https://github.com/iMumd/fathi-browser/issues"
  },
  "keywords": [
    "browser",
    "privacy",
    "fingerprint",
    "electron"
  ],
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node tools/check-syntax.js && node --test tools/test-research.js tools/test-network.js tools/test-identity.js tools/test-certificate.js tools/test-update-fallback.js && node tools/test-rules.js",
    "start": "electron .",
    "icons": "node tools/make-icons.js && node tools/make-installer-art.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux dir tar.gz --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --x64 --arm64 --publish never",
    "dist:all": "npm run dist:win && npm run dist:linux && npm run dist:mac"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.fathi.browser",
    "productName": "Fathi",
    "copyright": "Copyright 2026 iMumd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iMumd",
        "repo": "fathi-browser"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fathi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "artifactName": "Fathi-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "Fathi-Portable-${version}.${ext}"
    },
    "linux": {
      "extraResources": [
        {
          "from": "assets/icon-256.png",
          "to": "fathi.png"
        }
      ],
      "target": [
        "dir",
        "tar.gz"
      ],
      "icon": "build/icons",
      "category": "Network;WebBrowser",
      "executableName": "fathi",
      "artifactName": "Fathi-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Fathi",
          "Comment": "Private browser with per-tab fingerprints",
          "StartupWMClass": "Fathi"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Fathi-${version}-mac-${arch}.${ext}"
    }
  }
}
